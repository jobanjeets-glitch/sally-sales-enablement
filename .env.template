# Sally Sales Enablement Agent - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ==============================================================================
# PINECONE CONFIGURATION
# ==============================================================================
# Get from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=sally-sales-enablement

# ==============================================================================
# OPENAI CONFIGURATION
# ==============================================================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# GOOGLE DRIVE CONFIGURATION
# ==============================================================================
# Path to your Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# The ID of the Google Drive folder containing sales documentation
# Get from Drive folder URL: https://drive.google.com/drive/folders/[FOLDER_ID]
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# ==============================================================================
# SLACK CONFIGURATION
# ==============================================================================
# Get from: https://api.slack.com/apps
# Create a new Slack app with Socket Mode enabled

# Bot User OAuth Token (starts with xoxb-)
SALLY_SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token for Socket Mode (starts with xapp-)
SALLY_SLACK_APP_TOKEN=xapp-your-app-token-here

# Signing Secret from Basic Information page
SALLY_SLACK_SIGNING_SECRET=your_signing_secret_here

# Your personal Slack user ID — gets DM'd on every 👎 feedback
# Find it: Slack → click your profile → "Copy member ID"
SALLY_ADMIN_USER_ID=U0XXXXXXXXX

# Channel where Sally responds to ALL messages without needing @mention
SALLY_ASK_CHANNEL=C09H3DM4KED

# ==============================================================================
# ANTHROPIC CONFIGURATION (Sally v2)
# ==============================================================================
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# Health check port for Render keep-alive (default: 3001)
HEALTH_PORT=3001

# ==============================================================================
# SETUP CHECKLIST
# ==============================================================================
# [ ] 1. Create Pinecone account and index (1536 dimensions, cosine similarity)
# [ ] 2. Get OpenAI API key with access to GPT-4 and embeddings
# [ ] 3. Create Google Cloud service account and download credentials
# [ ] 4. Share Drive folder with service account email
# [ ] 5. Create Slack app with Socket Mode enabled
# [ ] 6. Add required Slack scopes: app_mentions:read, chat:write, im:history, im:read
# [ ] 7. Install Slack app to your workspace
# [ ] 8. Copy this file to .env and fill in all values
# [ ] 9. Run: npm run index (to index documents)
# [ ] 10. Run: npm start (to start the bot)
